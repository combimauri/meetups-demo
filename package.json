{
  "name": "meetups-demo",
  "version": "0.0.0",
  "scripts": {
    "dev": "concurrently -n agente,web -c magenta,cyan \"npm:agent\" \"npm:start\"",
    "dev:offline": "concurrently -n agente,web -c magenta,cyan \"npm:agent:offline\" \"npm:start\"",
    "start": "ng serve --proxy-config proxy.conf.json",
    "agent": "tsx watch --env-file-if-exists=.env server/index.ts",
    "agent:offline": "DEMO_OFFLINE=1 tsx server/index.ts",
    "build": "ng build",
    "test": "ng test"
  },
  "private": true,
  "packageManager": "npm@10.9.9",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@copilotkit/angular": "^0.6.0",
    "@copilotkit/runtime": "^1.86.0",
    "rxjs": "7.8.2",
    "tslib": "^2.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "rxjs": "7.8.2"
  }
}